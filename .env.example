# Premier démarrage uniquement : crée le compte administrateur si aucun compte n’existe.
# Choisissez au moins 12 caractères. Ne conservez pas cette valeur d’exemple.
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Oscar
ADMIN_PASSWORD=

# Adresse exacte utilisée dans le navigateur, sans slash final.
# En accès distant, renseigner https://cadeaux.votre-domaine.fr
APP_ORIGIN=http://localhost:3187
PORT=3187
# Pour un accès direct depuis le réseau local, indiquer 0.0.0.0.
BIND_ADDRESS=127.0.0.1
PUID=1000
PGID=1000
TZ=Europe/Paris

# Facultatif : SECRET (au moins 32 caractères), sinon créé et conservé dans data/.
# DATA_DIR permet de changer le dossier de données hors Docker.
# COOKIE_SECURE=true force les cookies HTTPS ; sinon détection automatique.
